{
  "version": 2,
  "builds": [
    {
      "src": "dashboard/app.py",
      "use": "@vercel/python",
      "config": {
        "requirementsFile": "requirements-vercel.txt",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "dashboard/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard/app.py"
    }
  ]
}
